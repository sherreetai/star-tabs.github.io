---
interface Props {
  eyebrow: string;
  title: string;
  mediaSrc?: string;
  layout?: 'centered' | 'paired' | 'split';
  divider?: 'right' | 'bottom' | 'right-bottom' | 'none';
  paddingTop?: 'default' | 'large';
  paddingBottom?: 'default' | 'none';
}

const { eyebrow, title, mediaSrc, layout, divider, paddingTop = 'default', paddingBottom = 'default' } = Astro.props;
const isGridSection = layout !== undefined;
const topPadding = paddingTop === 'large'
  ? 'pt-20 md:pt-28'
  : isGridSection
    ? layout === 'paired' ? 'pt-10 md:pt-12' : 'pt-10 md:pt-14'
    : 'pt-14 md:pt-20';
const bottomPadding = paddingBottom === 'none'
  ? 'pb-0 md:pb-0'
  : isGridSection
    ? layout === 'paired' ? 'pb-10 md:pb-12' : 'pb-10 md:pb-14'
    : 'pb-14 md:pb-20';
const sectionPadding = `${topPadding} ${bottomPadding}`;
const pairedDivider = [
  divider === 'none' ? '' : 'border-t border-line',
  divider === 'right' || divider === 'right-bottom' ? 'md:border-r md:border-line' : '',
  divider === 'bottom' || divider === 'right-bottom' ? 'border-b border-line' : '',
].filter(Boolean).join(' ');
const sectionClass = !isGridSection
  ? `relative mx-auto max-w-[1088px] px-6 ${sectionPadding}`
  : layout === 'centered'
    ? `px-6 ${topPadding} ${bottomPadding} md:col-span-2 md:px-20 ${divider === 'none' ? '' : 'border-t border-line'}`
    : layout === 'split'
      ? `px-6 ${topPadding} ${bottomPadding} md:col-span-2 md:px-12 ${divider === 'none' ? '' : 'border-t border-line'}`
      : `px-6 ${topPadding} ${bottomPadding} md:px-8 ${pairedDivider}`;
const contentClass = layout === 'split'
  ? 'mx-auto grid max-w-[880px] items-center gap-8 md:grid-cols-2'
  : 'mx-auto max-w-[640px]';
---

<section class={sectionClass}>
  {!isGridSection && divider !== 'none' && <div class="absolute inset-x-6 top-0 border-t border-line" aria-hidden="true"></div>}
  <div class={contentClass}>
    <div>
      <p class="type-eyebrow mb-2 text-center">{eyebrow}</p>
      <h2 class="type-section-title mb-6 text-center">{title}</h2>
      <div class="type-body [&_p+p]:mt-4">
        <slot />
      </div>
      {mediaSrc && layout !== 'split' && <img src={mediaSrc} alt="" loading="lazy" class="mt-8 aspect-[1.6/1] w-full rounded-lg bg-placeholder object-cover" />}
    </div>
    {mediaSrc && layout === 'split' && <img src={mediaSrc} alt="" loading="lazy" class="aspect-[1.3/1] w-full rounded-lg bg-placeholder object-cover md:aspect-[4/3]" />}
  </div>
</section>
