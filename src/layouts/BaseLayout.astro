---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Sher Ree Tai, product designer.',
} = Astro.props;
const pageTitle = title ? `${title} | Sher Ree Tai` : 'Sher Ree Tai, Product Designer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <script is:inline>
      var systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      var savedTheme = null;

      try {
        savedTheme = localStorage.getItem('site-theme');
      } catch (error) {
        console.error('Could not restore the color theme preference:', error);
      }

      var themePreference = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : 'system';
      document.documentElement.dataset.themePreference = themePreference;

      function applyTheme(isDark) {
        document.documentElement.classList.toggle('dark', isDark);
      }

      applyTheme(themePreference === 'system' ? systemTheme.matches : themePreference === 'dark');
      systemTheme.addEventListener('change', function (event) {
        if (document.documentElement.dataset.themePreference === 'system') {
          applyTheme(event.matches);
          document.dispatchEvent(new Event('site-theme-change'));
        }
      });
    </script>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="font-sans">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Pop-in on scroll: each group of elements appears together when any part of it enters the screen. -->
    <script is:inline>
      (function () {
        var groups = [];

        // Anything marked data-reveal is one group (the whole block pops in at once).
        document.querySelectorAll('[data-reveal]').forEach(function (el) { groups.push([el]); });

        // Case study sections and media blocks each appear as one group.
        document.querySelectorAll('.case-body').forEach(function (body) {
          var current = null;
          var prevWasHeading = false;
          Array.prototype.forEach.call(body.children, function (el) {
            var isHeading = /^H[2-6]$/.test(el.tagName);
            var isText = isHeading || /^(P|UL|OL)$/.test(el.tagName);
            if (!isText || !current || (isHeading && !prevWasHeading)) {
              current = [el];
              groups.push(current);
            } else {
              current.push(el);
            }
            if (!isText) current = null;
            prevWasHeading = isHeading;
          });
        });

        function show(group) {
          group.forEach(function (el) { el.classList.add('is-visible'); });
        }
        if (!('IntersectionObserver' in window)) { groups.forEach(show); return; }

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var group = entry.target.revealGroup;
            show(group);
            group.forEach(function (el) { io.unobserve(el); });
          });
        }, { rootMargin: '0px 0px -10% 0px' });

        groups.forEach(function (group) {
          group.forEach(function (el) { el.revealGroup = group; io.observe(el); });
        });
      })();
    </script>
  </body>
</html>
