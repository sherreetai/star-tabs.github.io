---
// The shared case study page: challenge, scope and outcome, body, next project.
// The content comes from the .mdx file in src/content/work/.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import NextProject from '../components/NextProject.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}
const { entry, next } = Astro.props;
const { title, scope, challengeHeading, challenge, outcome, heroImage } = entry.data;
const heroIsVideo = /\.(mp4|webm|mov)$/i.test(heroImage);
---

<BaseLayout title={title}>
  <section class="mx-auto max-w-[1088px] px-6 pt-10 pb-16 md:pt-14 md:pb-20" data-reveal>
    <div>
      <h1 class="type-page-title mb-10">{title}</h1>

      <p class="mb-2 text-sm font-medium"><span class="mr-2 inline-block w-6 border-b border-ink align-baseline"></span>Challenge</p>
      <h2 class="mb-4 max-w-[900px] text-xl leading-snug font-bold tracking-tight md:text-2xl">{challengeHeading}</h2>
      <p class="type-body max-w-[900px]">{challenge}</p>

      <dl class="mt-12 grid gap-8 md:grid-cols-[minmax(0,2fr)_minmax(220px,1fr)] md:gap-10">
        <div class="border-t border-line pt-5">
          <dt class="mb-3 text-sm font-medium"><span class="mr-2 inline-block w-6 border-b border-ink align-baseline"></span>Outcome</dt>
          <dd class="type-body">{outcome}</dd>
        </div>
        <div class="border-t border-line pt-5">
          <dt class="mb-3 text-sm font-medium"><span class="mr-2 inline-block w-6 border-b border-ink align-baseline"></span>Scope</dt>
          <dd class="flex flex-wrap gap-2">
            {scope.map((item) => <span class="rounded-full bg-chip px-3 py-1 text-xs">{item}</span>)}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {heroIsVideo ? (
    <video src={heroImage} autoplay muted loop playsinline aria-hidden="true" class="aspect-[4/3] max-h-[460px] w-full bg-placeholder object-cover md:aspect-[2.4/1]"></video>
  ) : (
    <img src={heroImage} alt="" class="aspect-[4/3] max-h-[460px] w-full bg-placeholder object-cover md:aspect-[2.4/1]" />
  )}

  <article class="case-body pb-12 md:pb-20">
    <slot />
  </article>

  <NextProject
    href={`/work/${next.id}/`}
    title={next.data.cardTitle ?? next.data.title}
    logo={next.data.logo}
  />
</BaseLayout>
